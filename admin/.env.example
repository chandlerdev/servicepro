# Template. Real values live in:
#   .env.development  → used by "npm run dev"   (your PC)
#   .env.production   → used by "npm run build" / "npm start" (live server)

# Backend base URL (Spring Boot). Local: http://localhost:9091  Live: https://<domain>
NEXT_PUBLIC_API_BASE_URL=http://localhost:9091

# Sub-path when served behind a reverse proxy (live: /admin). Leave empty locally.
NEXT_PUBLIC_BASE_PATH=

# Google Maps JavaScript API key (optional — a placeholder card is shown without it)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
