# Template only — copy to backend/.env and put your real values THERE (not in this file).
# The backend reads .env at startup; .env is git-ignored, this file is not.

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=servicepros
DB_USERNAME=root
DB_PASSWORD=

# --- Security ---
# Empty = built-in development key. Generate one for production: openssl rand -base64 64
JWT_SECRET=
SERVER_PORT=9091
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# --- Twilio SMS (leave blank to simulate: messages are logged as SIMULATED) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public HTTPS URL of POST /api/webhooks/twilio/sms (configure the same URL in Twilio console)
TWILIO_WEBHOOK_URL=

# --- Google Maps Platform (server key: Geocoding API + Routes API) ---
GOOGLE_MAPS_API_KEY=

# --- SMTP (optional; booking confirmation emails) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@servicepros.local

# --- First Super Admin login (created at startup only if no Super Admin exists) ---
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=change-me-to-a-strong-password
